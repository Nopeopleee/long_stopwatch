{
  "name": "disui",
  "compatibility_date": "2026-10-08",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "disui-db",
      "database_id": "2bc2efc9-4338-40af-81bf-2cb899a76805",
      "migrations_dir": "migrations"
    }
  ]
}
